# MongoDB Atlas connection string.
# Create a free cluster at https://www.mongodb.com/cloud/atlas/register,
# add a database user + allow your current IP (or 0.0.0.0/0 for local dev only),
# then copy the "Connect your application" URI here and swap in your db name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/whishlist?retryWrites=true&w=majority

# Secret used to sign the v1 stub-auth JWT session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-64-char-hex-string

# Base URL of the app, used for building shareable wishlist links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
