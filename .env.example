# MongoDB Atlas connection string.
# Create a free cluster at https://www.mongodb.com/cloud/atlas/register,
# add a database user + allow your current IP (or 0.0.0.0/0 for local dev only),
# then copy the "Connect your application" URI here and swap in your db name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/whishlist?retryWrites=true&w=majority

# Secret used to sign the session JWT cookie, and as an HMAC pepper for hashing OTP codes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-64-char-hex-string

# Base URL of the app, used for building shareable wishlist links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Resend API key for sending real OTP login emails (https://resend.com).
# If unset, the 6-digit code is printed to the server console instead — handy for local dev.
RESEND_API_KEY=

# Optional: the "from" address for OTP emails. Defaults to Resend's shared test address,
# which only works for Resend's own test flows — use a verified domain address for real use.
RESEND_FROM_EMAIL=onboarding@resend.dev
